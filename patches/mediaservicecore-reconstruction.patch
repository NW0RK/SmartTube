+package com.liskovsoft.youtubeapi.common.helpers;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.text.format.DateUtils;
+import com.liskovsoft.sharedutils.prefs.GlobalPreferences;
+import com.liskovsoft.youtubeapi.R;
+import java.text.DateFormat;
+import java.text.ParsePosition;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class PublicationDateFormatter {
+    private static final long DAY = 86400000;
+    private static final long HOUR = 3600000;
+    private static final long MINUTE = 60000;
+    private static final long MONTH = 2592000000L;
+    private static final long YEAR = 31536000000L;
+    private static final Pattern NUMBER = Pattern.compile("[\\p{N}.,]+");
+    private static final ConcurrentHashMap<Locale, List<Pattern>> RELATIVE_PATTERNS = new ConcurrentHashMap<>();
+    private static final Pattern PREFIX = Pattern.compile("^(?:published|premiered|released|streamed(?: live)?)(?: on)?\\s+", 2);
+    private static final Pattern ENGLISH_RELATIVE = Pattern.compile("^(?:(?:streamed(?: live)?|started streaming|premiered|published)\\s+)?(?:less than |<\\s*)?[\\p{N}.,]+\\s*(?:seconds?|minutes?|hours?|days?|weeks?|months?|years?|secs?|mins?|hrs?|mos?|yrs?|[smhdwy])\\s+ago$", 2);
+    private static final String[] DATE_PATTERNS = {"yyyy-MM-dd'T'HH:mm:ss.SSSZ", "yyyy-MM-dd'T'HH:mm:ssZ", "yyyy-MM-dd'T'HH:mm:ss.SSS", "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd", "MMM d, yyyy", "MMMM d, yyyy", "d MMM yyyy", "d MMMM yyyy", "MMM d yyyy", "MMMM d yyyy", "d MMM, yyyy", "d MMMM, yyyy"};
+
+    private PublicationDateFormatter() {
+    }
+
+    public static String format(String text) {
+        return format(text, null);
+    }
+
+    public static String format(String relativeText, String calendarText) {
+        Context context = GlobalPreferences.context();
+        return format(relativeText, calendarText, Locale.getDefault(), System.currentTimeMillis(), context != null ? context.getResources() : null);
+    }
+
+    static String format(String relativeText, String calendarText, Locale locale, long now, Resources resources) {
+        String result = normalize(relativeText, locale, now, resources);
+        return result != null ? result : normalize(calendarText, locale, now, resources);
+    }
+
+    private static String normalize(String text, Locale locale, long now, Resources resources) {
+        if (text == null || text.trim().isEmpty()) {
+            return null;
+        }
+        String clean = text.replace('\u00a0', ' ').replace((char) 8239, ' ').trim();
+        if (ENGLISH_RELATIVE.matcher(clean).matches() || clean.equalsIgnoreCase("just now") || clean.equalsIgnoreCase("today") || clean.equalsIgnoreCase("yesterday")) {
+            return text.trim();
+        }
+        String dateText = PREFIX.matcher(clean).replaceFirst("");
+        Date date = parseDate(dateText, locale);
+        if (date != null) {
+            if (date.getTime() > now) {
+                return null;
+            }
+            return formatAge(now - date.getTime(), resources);
+        }
+        if (!isLocalizedRelative(clean, now)) {
+            return null;
+        }
+        return text.trim();
+    }
+
+    private static Date parseDate(String text, Locale locale) {
+        String iso = text.replaceFirst("Z$", "+0000").replaceFirst("([+-]\\d{2}):(\\d{2})$", "$1$2");
+        Locale[] localeArr = {locale, Locale.US};
+        for (int i = 0; i < 2; i++) {
+            Locale candidate = localeArr[i];
+            for (String pattern : DATE_PATTERNS) {
+                Date date = parseFully(new SimpleDateFormat(pattern, candidate), iso);
+                if (date != null) {
+                    return date;
+                }
+            }
+            int[] iArr = {0, 1, 2, 3};
+            for (int i2 = 0; i2 < 4; i2++) {
+                int style = iArr[i2];
+                Date date2 = parseFully(DateFormat.getDateInstance(style, candidate), text);
+                if (date2 != null) {
+                    return date2;
+                }
+            }
+        }
+        return null;
+    }
+
+    private static Date parseFully(DateFormat format, String text) {
+        format.setLenient(false);
+        ParsePosition position = new ParsePosition(0);
+        Date result = format.parse(text, position);
+        if (result == null || position.getIndex() != text.length()) {
+            return null;
+        }
+        return result;
+    }
+
+    private static boolean isLocalizedRelative(String text, long now) {
+        Locale locale = Locale.getDefault();
+        List<Pattern> patterns = RELATIVE_PATTERNS.get(locale);
+        if (patterns == null) {
+            patterns = new ArrayList<>();
+            long[] jArr = {60000, HOUR, 86400000};
+            int i = 0;
+            for (int i2 = 3; i < i2; i2 = 3) {
+                long unit = jArr[i];
+                int[] iArr = {1, 2, 5, 21};
+                int i3 = 0;
+                for (int i4 = 4; i3 < i4; i4 = 4) {
+                    int count = iArr[i3];
+                    if (((long) count) * unit < 604800000) {
+                        String sample = relativeSample(unit, count, now);
+                        Matcher number = NUMBER.matcher(sample);
+                        String regex = number.find() ? Pattern.quote(sample.substring(0, number.start())) + "[\\p{N}.,]+" + Pattern.quote(sample.substring(number.end())) : Pattern.quote(sample);
+                        patterns.add(Pattern.compile(regex));
+                    }
+                    i3++;
+                }
+                i++;
+            }
+            addRelativeMarkerPattern(patterns, relativeSample(HOUR, 5, now), relativeSample(86400000L, 5, now));
+            RELATIVE_PATTERNS.put(locale, patterns);
+        }
+        for (Pattern pattern : patterns) {
+            if (pattern.matcher(text).matches()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String relativeSample(long unit, int count, long now) {
+        return DateUtils.getRelativeTimeSpanString(now - (((long) count) * unit), now, unit, 16).toString().replace('\u00a0', ' ').replace((char) 8239, ' ');
+    }
+
+    private static void addRelativeMarkerPattern(List<Pattern> patterns, String hours, String days) {
+        Pattern pattern = NUMBER;
+        Matcher hourNumber = pattern.matcher(hours);
+        Matcher dayNumber = pattern.matcher(days);
+        if (!hourNumber.find() || !dayNumber.find()) {
+            return;
+        }
+        String prefix = hours.substring(0, hourNumber.start());
+        if (prefix.equals(days.substring(0, dayNumber.start()))) {
+            String hourSuffix = hours.substring(hourNumber.end());
+            String daySuffix = days.substring(dayNumber.end());
+            int length = 0;
+            while (length < Math.min(hourSuffix.length(), daySuffix.length()) && hourSuffix.charAt((hourSuffix.length() - length) - 1) == daySuffix.charAt((daySuffix.length() - length) - 1)) {
+                length++;
+            }
+            String suffix = hourSuffix.substring(hourSuffix.length() - length);
+            if (!suffix.isEmpty() && !Character.isWhitespace(suffix.charAt(0)) && suffix.contains(" ")) {
+                suffix = suffix.substring(suffix.indexOf(32));
+            }
+            if ((prefix.trim().isEmpty() && suffix.trim().isEmpty()) || suffix.trim().equalsIgnoreCase("ago")) {
+                return;
+            }
+            patterns.add(Pattern.compile(Pattern.quote(prefix) + "[\\p{N}.,]+[\\p{L}\\p{M}\\s]+" + Pattern.quote(suffix)));
+        }
+    }
+
+    private static String formatAge(long age, Resources resources) {
+        long unit;
+        int resource;
+        String name;
+        if (age < 60000) {
+            return resources != null ? resources.getString(R.string.publication_just_now) : "just now";
+        }
+        if (age < HOUR) {
+            unit = 60000;
+            resource = R.plurals.publication_minutes_ago;
+            name = "minute";
+        } else if (age < 86400000) {
+            unit = HOUR;
+            resource = R.plurals.publication_hours_ago;
+            name = "hour";
+        } else if (age < MONTH) {
+            unit = 86400000;
+            resource = R.plurals.publication_days_ago;
+            name = "day";
+        } else if (age < YEAR) {
+            unit = MONTH;
+            resource = R.plurals.publication_months_ago;
+            name = "month";
+        } else {
+            unit = YEAR;
+            resource = R.plurals.publication_years_ago;
+            name = "year";
+        }
+        int count = (int) Math.min(Integer.MAX_VALUE, age / unit);
+        if (resources != null) {
+            return resources.getQuantityString(resource, count, Integer.valueOf(count));
+        }
+        return count + " " + name + (count == 1 ? "" : "s") + " ago";
+    }
+}
