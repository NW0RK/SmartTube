<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp"
    android:padding="12dp" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileThumbnailView
            android:id="@+id/mobile_thumbnail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scaleType="centerCrop"
            android:importantForAccessibility="no" android:background="@drawable/mobile_thumbnail_bg"/>
        <TextView android:id="@+id/mobile_duration" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:layout_margin="4dp" android:padding="3dp" android:textColor="#FFFFFF"
            android:textSize="12sp" android:background="#CC000000"/>
    </FrameLayout>
    <Button android:id="@+id/mobile_card_menu" android:layout_width="48dp"
        android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
        android:gravity="center" android:includeFontPadding="false"
        android:text="⋮" android:textColor="#FFFFFF"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/mobile_more"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/mobile_card_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end"
            android:includeFontPadding="false" android:lineSpacingExtra="2dp"
            android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/mobile_card_channel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:includeFontPadding="false" android:textSize="14sp" android:maxLines="1"
            android:ellipsize="end" android:textColor="@color/mobile_text_secondary"/>
        <TextView android:id="@+id/mobile_card_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/mobile_text_secondary"/>
    </LinearLayout>
    <View android:layout_width="48dp" android:layout_height="1dp" android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
